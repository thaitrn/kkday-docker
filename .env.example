# KKday API Configuration
KKdayApi__Url=https://api-b2d-10.sit.kkday.com/v4
KKdayApi__AuthorToken=your_b2d_api_token_here

# Application Settings
Currency=TWD
Marketing=TW

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80;https://+:443

# Security
# Set to "true" ONLY in Development environment for testing self-signed certificates
# NEVER set to "true" in Production!
DisableSSLValidation=false

# Encryption
# Generate your own 32-byte hex key for production
# Example: openssl rand -hex 32
AesCryptoKey=

# Google Maps API Key
GoogleMapsApiKey=
